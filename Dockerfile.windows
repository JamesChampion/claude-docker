# Simple Dockerfile for Windows - minimal setup, install everything on startup
FROM node:20-slim

# Install basic system packages
RUN apt-get update && apt-get install -y \
    git \
    curl \
    python3 \
    build-essential \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Delete default node user/group if exists to avoid conflicts
RUN deluser node || true
RUN delgroup node || true

# Create user with standard UID/GID
RUN groupadd -g 1000 claude-user && \
    useradd -m -s /bin/bash -u 1000 -g claude-user claude-user && \
    echo "claude-user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Install Claude Code globally
RUN npm install -g @anthropic-ai/claude-code

# Copy startup script and fix line endings
COPY startup-windows.sh /usr/local/bin/startup.sh
RUN sed -i 's/\r$//' /usr/local/bin/startup.sh && \
    chmod +x /usr/local/bin/startup.sh

# Switch to claude-user
USER claude-user
WORKDIR /workspace

# Install uv for MCP servers
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Add to PATH
ENV PATH="/home/claude-user/.local/bin:${PATH}"
ENV HOME=/home/claude-user

# Use startup script
CMD ["/usr/local/bin/startup.sh"]
